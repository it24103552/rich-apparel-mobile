# Server
PORT=5001
NODE_ENV=development
TRUST_PROXY=1
ENFORCE_HTTPS=false

# Public Base URLs (used for absolute media links & email links)
API_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed by CORS (required in staging/production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database (MongoDB Atlas / MongoDB)
DATABASE_URL=your_mongodb_connection_string_here

# Authentication (JWT)
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_separate_strong_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP / Gmail App Password)
EMAIL_USER=your_email_here
EMAIL_PASSWORD=your_email_app_password_here

# Supabase Storage (Public media bucket for product/review/return/payment images)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Features (Optional: Groq & Replicate)
GROQ_API_KEY=your_groq_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
